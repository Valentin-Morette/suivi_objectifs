# MySQL
# Local Mac (MAMP) : port souvent 8889
# VPS : en général 127.0.0.1:3306
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=objectifs

# Délai connexion (ms) — évite d’attendre 30s si MySQL est arrêté
DB_CONNECT_TIMEOUT_MS=5000

# API (backend)
PORT=3001

# Stats sociales (pseudo : birious_3D)
YOUTUBE_HANDLE=birious_3D
TIKTOK_HANDLE=birious_3D
# Clé Google Cloud → YouTube Data API v3 (obligatoire pour YouTube)
YOUTUBE_API_KEY=

# Chess.com (API publique)
CHESS_USERNAME=birious
